        "x-enum-varnames": [
          "PREPARING",
          "READY_FOR_PICKUP",
          "PICKED_UP",
          "WAITING_AT_PORT",
          "DEPARTED"
        ]
      },
      "ShipmentType": {
        "type": "string",
        "enum": [
          "sea",
          "air",
          "land"
        ],
        "x-enum-varnames": [
          "SEA",
          "AIR",
          "LAND"
        ]
      },
      "PaymentTerms": {
        "type": "string",
        "enum": [
          "prepaid",
          "collect"
        ],
        "x-enum-varnames": [
          "PREPAID",
          "COLLECT"
        ]
      },
      "Incoterm": {
        "type": "string",
