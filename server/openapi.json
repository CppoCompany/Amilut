      "CustomerDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 1
          },
          "name": {
            "type": "string",
            "example": "Acme Imports Ltd."
          },
          "address": {
            "type": "string",
            "nullable": true,
            "example": "1 Herzl St, Tel Aviv"
          },
          "phone": {
            "type": "string",
            "nullable": true,
            "example": "+972-3-1234567"
          },
          "email": {
            "type": "string",
            "nullable": true,
            "example": "office@acme.co.il"
          },
          "isActive": {
            "type": "boolean",
            "example": true
          }
        },
        "required": [
          "id",
          "name",
          "address",
          "phone",
          "email",
          "isActive"
        ]
      },
      "CreateCustomerDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Acme Imports Ltd.",
            "minLength": 1,
            "maxLength": 255
          },
          "address": {
            "type": "string",
            "nullable": true,
            "example": "1 Herzl St, Tel Aviv",
            "maxLength": 500
          },
          "phone": {
            "type": "string",
            "nullable": true,
            "example": "+972-3-1234567",
            "maxLength": 50
          },
          "email": {
            "type": "string",
            "nullable": true,
            "format": "email",
            "example": "office@acme.co.il",
            "maxLength": 255
          }
        },
        "required": [
          "name"
