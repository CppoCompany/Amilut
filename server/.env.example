# Secret used to sign our own JWTs. Use a long random string in real environments.
JWT_SECRET=change-me-to-a-long-random-string

# JWT lifetime (zeit/ms format, e.g. 8h, 30m, 7d). Defaults to 8h when unset.
JWT_EXPIRES_IN=8h

# Comma-separated list of user emails (user name = email) allowed to sign in
# (case-insensitive, whitespace trimmed). Empty = allow any email.
ALLOWED_EMAILS=

# Optional email-domain restriction, e.g. example.com. Empty = none.
ALLOWED_DOMAIN=

# PostgreSQL connection (defaults match SQL-Migration/README.md: role Admin / db Amilut).
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=Admin
PGPASSWORD=Admin
PGDATABASE=Amilut
