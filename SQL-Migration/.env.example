# Copy this file to the repo root as `.env` (gitignored).
# `npm run db:generate` loads the root .env automatically (Node --env-file-if-exists).
# Running the runner directly: node --env-file-if-exists=.env SQL-Migration/run-migrations.mjs

# --- Superuser connection — needed ONLY for a first run on a fresh PostgreSQL
#     (step 001 creates the role + database). Leave PGPASSWORD commented out and
#     the runner falls back to the app role Admin/Admin, which is enough once
#     the database exists.
PGHOST=127.0.0.1
PGPORT=5432
PGSUPERUSER=postgres
# PGPASSWORD=<postgres superuser password>

# --- App role password used by the fallback (must match 001). Default: Admin
# PGAPPPASSWORD=Admin

# The application role/database/password are defined in the SQL files:
#   role     = Admin  (password Admin)
#   database = Amilut
# Change them there if you need different values.
